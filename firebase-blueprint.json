{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, email, and authentication details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["engineer", "operator", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "VoiceAgent": {
      "title": "VoiceAgent",
      "description": "User custom voice agent pipeline configuration and parameter settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "transport": { "type": "string", "maxLength": 50 },
        "vad": { "type": "string", "maxLength": 50 },
        "stt": { "type": "string", "maxLength": 50 },
        "llm": { "type": "string", "maxLength": 50 },
        "tts": { "type": "string", "maxLength": 50 },
        "flow": { "type": "string", "maxLength": 50 },
        "latencyTargetMs": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "llm", "tts"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "Recorded conversational session with transcript messages and pipeline telemetry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "durationSec": { "type": "number" },
        "turnCount": { "type": "number" },
        "avgLatencyMs": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "active", "cancelled"] },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "status"]
    },
    "VoiceSettings": {
      "title": "VoiceSettings",
      "description": "Voice persona tuning configuration including speaking rate, pitch, and tone stability.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "personaId": { "type": "string", "maxLength": 100 },
        "voiceId": { "type": "string", "maxLength": 128 },
        "speakingRate": { "type": "number" },
        "pitch": { "type": "number" },
        "stability": { "type": "number" },
        "gender": { "type": "string", "enum": ["female", "male"] },
        "accent": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "speakingRate", "pitch", "stability"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user account profile information keyed by auth UID."
    },
    "/voice_agents/{agentId}": {
      "schema": "VoiceAgent",
      "description": "Stores custom voice agent configurations owned by users."
    },
    "/call_sessions/{sessionId}": {
      "schema": "CallSession",
      "description": "Stores voice session histories, message transcripts, and metrics."
    },
    "/voice_settings/{settingId}": {
      "schema": "VoiceSettings",
      "description": "Stores user voice persona settings including speaking rate, pitch, and tone stability."
    }
  }
}
