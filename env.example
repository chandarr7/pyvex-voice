# Configuration for pyvex-voice.
#
# Only the variables below are read by this application. Copy this file to
# `.env` and fill in the values; `.env` is gitignored and must never be
# committed.

# --- Server secrets (never exposed to the browser) -------------------------

# Google Gemini API key. Without it the API reports LLM_NOT_CONFIGURED and
# every conversation endpoint fails honestly; nothing is substituted.
GEMINI_API_KEY=

# --- Server: Supabase ------------------------------------------------------

# Your project URL, e.g. https://abcdefghijkl.supabase.co
# The API verifies access tokens against this project's issuer. Without it the
# authenticated routes reject every request (AUTH_NOT_CONFIGURED) rather than
# serving anyone unauthenticated.
SUPABASE_URL=

# Only for a project still signing tokens with a shared HS256 secret. Leave
# blank on a project using asymmetric signing keys: the API then verifies
# against the published JWKS and needs no secret at all. This value is a
# secret; it must never carry a VITE_ prefix.
SUPABASE_JWT_SECRET=

# --- Optional server settings ----------------------------------------------

# Comma-separated Gemini model ids this deployment accepts. Unset uses the
# built-in list in server/models.ts.
# PYVEX_GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash

# PORT=3000
# HOST=0.0.0.0

# --- Public client configuration -------------------------------------------
#
# The project URL and anon key are public by design: they identify the project
# and carry no privilege of their own. Access is enforced by the row-level
# security policies in supabase/migrations/, not by hiding these values.
#
# Never put a secret behind a VITE_ prefix: everything VITE_ is compiled into
# the browser bundle. In particular the service-role key belongs nowhere near
# this section.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
