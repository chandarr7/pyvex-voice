# Configuration for pyvex-voice.
#
# Only the variables below are read by this application. Copy this file to
# `.env` and fill in the values; `.env` is gitignored and must never be
# committed.

# --- Server secrets (never exposed to the browser) -------------------------

# Google Gemini API key. Without it the API reports LLM_NOT_CONFIGURED and
# every conversation endpoint fails honestly; nothing is substituted.
GEMINI_API_KEY=

# Firebase Admin credentials, used to verify the ID tokens the browser sends.
# Without them the authenticated API routes reject every request
# (AUTH_NOT_CONFIGURED) rather than serving anyone unauthenticated.
FIREBASE_PROJECT_ID=
# Absolute path to a service-account JSON file. Keep the file out of the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Optional server settings ----------------------------------------------

# Comma-separated Gemini model ids this deployment accepts. Unset uses the
# built-in list in server/models.ts.
# PYVEX_GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash

# PORT=3000
# HOST=0.0.0.0

# --- Public client configuration -------------------------------------------
#
# Firebase web config is public by design: access is enforced by
# firestore.rules, not by hiding these values. They fall back to
# firebase-applet-config.json when unset. Never put a secret behind a VITE_
# prefix, since everything VITE_ is compiled into the browser bundle.

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=
