# Configuration for pyvex-voice.
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Anything prefixed VITE_ is compiled into the browser bundle. Never put a
# secret behind that prefix.

# =============================================================================
# SERVER SECRETS — never exposed to the browser
# =============================================================================

# Google Gemini. Used by the API for text chat and by the voice worker for
# conversation turns. Without it those paths fail honestly; nothing is
# substituted.
GEMINI_API_KEY=

# ElevenLabs. Used by the voice worker for both speech recognition and
# synthesis. Without it the worker reports itself unready.
ELEVENLABS_API_KEY=

# Supabase service role. Only needed for server-side work that must bypass
# row-level security. Leave blank unless something genuinely requires it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between the API and the voice worker. Any sufficiently long
# random string, identical on both sides. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both fail closed without it: the worker refuses every request and the API
# refuses to create a session.
VOICE_WORKER_TOKEN=
PYVEX_WORKER_TOKEN=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Supabase project URL. The API verifies access tokens against this issuer.
# Without it the authenticated routes reject every request.
SUPABASE_URL=

# Only for a project still signing tokens with a shared HS256 secret. Leave
# blank on a project using asymmetric keys: the API then verifies against the
# published JWKS and needs no secret at all.
SUPABASE_JWT_SECRET=

# Where the API reaches the voice worker. Keep this on a private network or
# loopback; the worker is not meant to be publicly routable.
VOICE_WORKER_URL=http://127.0.0.1:7860

PORT=3000
NODE_ENV=development

# =============================================================================
# VOICE WORKER
# =============================================================================

PYVEX_WORKER_HOST=127.0.0.1
PYVEX_WORKER_PORT=7860

# STUN servers the worker gathers ICE candidates from. Without one it only
# offers host candidates, which fail as soon as the browser is not on the same
# network. A TURN server is needed for callers behind restrictive NATs.
PYVEX_ICE_SERVERS=stun:stun.l.google.com:19302

# Model and voice overrides. Unset uses the defaults in
# voice/src/pyvex_voice/config.py and voices.py.
# PYVEX_LLM_MODEL=gemini-2.5-flash
# PYVEX_STT_MODEL=scribe_v1
# PYVEX_TTS_MODEL=eleven_turbo_v2_5
# PYVEX_DEFAULT_VOICE_PROFILE=warm_professional

# JSON array replacing the built-in voice profiles, each entry carrying id,
# provider_voice_id, display_name and description.
# PYVEX_VOICE_PROFILES=[{"id":"house","provider_voice_id":"...","display_name":"House"}]

# Gemini models the API accepts. Unset uses the built-in list in
# server/models.ts.
# PYVEX_GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash

# =============================================================================
# PUBLIC CLIENT CONFIGURATION
# =============================================================================
#
# The project URL and anon key are public by design: they identify the project
# and carry no privilege of their own. Access is enforced by the row-level
# security policies in supabase/migrations/, not by hiding these values.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
